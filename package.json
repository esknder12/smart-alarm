{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "lint": "tsc --noEmit",
    "test": "tsx tests/volumeLock.test.ts && tsx tests/alarmScheduler.test.ts && tsx tests/alarmText.test.ts && tsx tests/wakeChallenge.test.ts && tsx tests/alarmEditor.test.ts && tsx tests/firstRun.test.ts && tsx tests/onboardingTour.test.ts && tsx tests/defaultLanguage.test.ts",
    "test:lock": "tsx tests/volumeLock.test.ts",
    "test:schedule": "tsx tests/alarmScheduler.test.ts",
    "test:text": "tsx tests/alarmText.test.ts",
    "test:editor": "tsx tests/alarmEditor.test.ts",
    "test:first-run": "tsx tests/firstRun.test.ts && tsx tests/onboardingTour.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.1.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
